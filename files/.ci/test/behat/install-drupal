#!/bin/bash

# Installs Drupal for Behat tests against a fresh (content-less) database.
#
# Distributed by helloworlddevs/pantheon-ci-tools. The behat_setup/behat_test
# jobs in .circleci/config.yml call this script; project-specific work (theme
# build, file ownership, etc.) belongs in the project's configure-site, not here.
#
# Strategy: detect the install profile from the committed config and install
# THAT profile by name, then import the exported config on top.
#
# Why install the project's own profile (not standard/minimal):
#   - Sites with a CUSTOM profile keep their modules/themes nested under
#     profiles/<profile>/. Drupal only discovers those once that profile is the
#     installed one, so installing a generic profile then importing config fails
#     with "Cannot change the install profile ..." and "Unable to install the
#     <module> since it does not exist" — and a retry loop around it spins
#     forever.
#
# Why NOT `site:install --existing-config`:
#   - Drupal refuses it for any profile that implements hook_install() ("The
#     selected profile has a hook_install() implementation and therefore can not
#     be installed from configuration"), which many custom profiles do.
#     Installing the profile and then importing config works for both kinds.

set -eo pipefail

DRUSH="./vendor/bin/drush"

SYNC_DIR="${CONFIG_SYNC_DIR:-config/sync}"
CORE_EXT="${SYNC_DIR}/core.extension.yml"
SITE_YML="${SYNC_DIR}/system.site.yml"

# Detect the install profile declared in the committed config, if any.
PROFILE=""
if [ -f "$CORE_EXT" ]; then
  PROFILE="$(awk -F':[[:space:]]*' '/^profile:/ {gsub(/["'"'"'[:space:]]/,"",$2); print $2; exit}' "$CORE_EXT")"
fi

if [ -n "$PROFILE" ]; then
  echo "Installing Drupal with profile: ${PROFILE}"
  $DRUSH -y site:install "$PROFILE"
else
  echo "No profile detected in ${CORE_EXT}; installing default profile."
  $DRUSH -y site:install
fi

# If the project ships exported config, import it on top of the fresh install.
if [ -f "$CORE_EXT" ]; then
  # config:import requires the active site UUID to match the exported one.
  if [ -f "$SITE_YML" ]; then
    UUID="$(awk -F':[[:space:]]*' '/^uuid:/ {gsub(/["'"'"'[:space:]]/,"",$2); print $2; exit}' "$SITE_YML")"
    if [ -n "$UUID" ]; then
      echo "Aligning site UUID to exported config: ${UUID}"
      $DRUSH -y config:set system.site uuid "$UUID"
    fi
  fi

  # The installer auto-creates a default shortcut set that can collide with
  # imported config on some profiles. Drop it if shortcut is enabled. Non-fatal.
  $DRUSH -y ev 'if (\Drupal::moduleHandler()->moduleExists("shortcut")) { $s = \Drupal::entityTypeManager()->getStorage("shortcut_set")->load("default"); if ($s) { $s->delete(); } }' || true

  echo "Importing configuration..."
  $DRUSH -y config:import
fi

echo "Running DB Updates"
$DRUSH updb -y;

echo "Clearing caches..."
$DRUSH cr;

# Get status for debugging purposes.
$DRUSH status;
